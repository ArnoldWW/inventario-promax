---
import CurrencyInput from "@/components/CurrencyInput.astro";
---

<div class="flex flex-col gap-1">
  <p>Origen del producto:</p>

  <div class="flex items-center gap-1">
    <input
      class="w-auto"
      type="radio"
      id="imported"
      name="origin"
      value="importado"
      autocomplete="off"
      checked
    />
    <label for="imported">Importado</label>
  </div>

  <div class="flex items-center gap-1">
    <input
      class="w-auto"
      type="radio"
      id="local"
      name="origin"
      value="local"
      autocomplete="off"
    />
    <label for="local">local</label>
  </div>
</div>

<div id="imported-fields" class="flex flex-col gap-2">
  <CurrencyInput
    label="Precio dolar (COP)"
    id="dollar-cop-input"
    name="dollar_cop"
    currency="COP"
    placeholder="$3.500"
  />

  <CurrencyInput
    label="Precio producto (USD)"
    id="price-input-usd"
    name="price_usd"
    currency="USD"
    placeholder="$1,000"
  />
</div>

<div id="non-imported-fields" class="hidden">
  <CurrencyInput
    label="Precio producto (COP)"
    id="price-input-cop"
    name="price_cop"
    currency="COP"
    placeholder="$2.000.000"
  />
</div>

<script>
  // Handle enabling/disabling inputs based on product type
  const productTypeRadios = document.querySelectorAll<HTMLInputElement>(
    'input[name="origin"]'
  );

  productTypeRadios.forEach((radio) => {
    radio.addEventListener("change", () => {
      const importedFieldWrapper =
        document.querySelector<HTMLElement>("#imported-fields");
      const nonImportedFieldWrapper = document.querySelector<HTMLElement>(
        "#non-imported-fields"
      );

      const importedInputs = document.querySelectorAll<HTMLInputElement>(
        "#imported-fields input"
      );
      const nonImportedInputs = document.querySelectorAll<HTMLInputElement>(
        "#non-imported-fields input"
      );

      if (radio.value === "importado") {
        importedFieldWrapper?.classList.remove("hidden");
        nonImportedFieldWrapper?.classList.add("hidden");

        nonImportedInputs.forEach((input) => {
          input.value = "";
        });
      } else {
        importedFieldWrapper?.classList.add("hidden");
        nonImportedFieldWrapper?.classList.remove("hidden");

        importedInputs.forEach((input) => {
          input.value = "";
        });
      }
    });
  });
</script>
