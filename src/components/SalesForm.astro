---
import CurrencyInput from "@/components/CurrencyInput.astro";
interface Props {
  productId: string;
}
const { productId } = Astro.props;
---

<!-- CREATE TABLE `sales` (
	`id` text PRIMARY KEY,
	`product_id` text NOT NULL UNIQUE,
	`customer_name` text NOT NULL,
	`notes` text,
	`price` integer NOT NULL,
	`created_at` text DEFAULT CURRENT_TIMESTAMP NOT NULL,
	CONSTRAINT `fk_sales_product_id_products_id_fk` FOREIGN KEY (`product_id`) REFERENCES `products`(`id`)
); -->
<form id="sales-form" class="flex flex-col gap-2 my-2" autocomplete="off">
  <input type="hidden" id="product_id" name="product_id" value={productId} />

  <label for="customer_name">Nombre del cliente</label>
  <input
    type="text"
    id="customer_name"
    name="customer_name"
    placeholder="Nombre del cliente"
    value=""
    required
  />

  <CurrencyInput
    label="Precio de venta (COP)"
    id="sale-price"
    name="price"
    currency="COP"
    placeholder="$3.500.000"
  />

  <label for="accessories">Notas de la venta</label>
  <textarea
    id="notes"
    name="notes"
    placeholder="Accesorios, observaciones, etc."
    rows="2"></textarea>

  <button type="submit" class="btn">Vender producto</button>
</form>

<script>
  import { actions, isInputError, isActionError } from "astro:actions";
  import type { ActionError } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("#sales-form");

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      const product_id = String(formData.get("product_id"));
      formData.set("product_id", product_id);

      // Remove non-numeric characters from price field
      const sale_price = formData.get("price") as string;
      if (sale_price.trim() && typeof sale_price === "string") {
        formData.set("price", sale_price.replace(/\D/g, ""));
      }
      console.log(formData);

      // Function to show errors in an alert
      function showErrors(error: ActionError) {
        if (error && isInputError(error)) {
          const plainArray = Object.entries(error.fields).map(
            ([field, message]) => {
              return `${field}: ${message}`;
            }
          );

          alert("Campos con error:\n" + plainArray.join("\n"));

          return;
        }

        if (error && isActionError(error)) {
          alert(error.message);
          return;
        }
      }

      const { data, error} = await actions.sales.create(formData);

      if (error) {
        showErrors(error);
        return;
      }

      alert(data?.message);
    });
  }
</script>
