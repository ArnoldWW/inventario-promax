---
import type { Product, Sale } from '@/types';
import { formatCurrency, calculateTotalValue, formatDate } from '@/utils';

interface Props {
	product: Product,
	sale: Sale
}

const { product, sale } = Astro.props as Props;

const saleDate = sale
  ? formatDate(sale.created_at)
  : null;

const productValue = calculateTotalValue(
  String(product.status),
  String(product.origin),
  Number(product.dollar_cop),
  Number(product.price_usd),
  Number(product.price_cop)
);
const salePrice = Number(sale.price);
const profit = salePrice - productValue;
---

<div class="flex flex-col gap-2 my-2">
  <p class="text-green-500 uppercase font-bold bg-green-100 p-2 text-center">
    PRODUCTO VENDIDO A {sale.customer_name}
  </p>

  <h2>
    Datos de la venta
  </h2>
  <p>
    <strong>ID de la venta: </strong>
    {sale.id}
  </p>
  <p>
    <strong>Cliente: </strong>
    {sale.customer_name}
  </p>
  <p>
    <strong>Precio de venta: </strong>
    {formatCurrency(Number(sale.price))}
  </p>

  <p>
    <strong>Ganancia: </strong>
    {formatCurrency(profit)}
  </p>

  <p>
    <strong>Fecha de venta: </strong>
    {saleDate}
  </p>

  <p>
    <strong>Notas: </strong>
    {sale?.notes || "-"}
  </p>

  <button id="cancel-sale" class="btn bg-red-500 my-3" data-id={sale.id}>
    Cancelar venta
  </button>
</div>

<script>
  import { actions } from "astro:actions";
  const cancelSaleButton = document.querySelector<HTMLButtonElement>("#cancel-sale");

  cancelSaleButton?.addEventListener("click", async () => {
    const confirmCancel = confirm(
      "¿Estás seguro de que deseas cancelar esta venta? Esta acción no se puede deshacer."
    );

    if (!confirmCancel) {
      return;
    }

    // Get the sale ID from the button's data attribute
    const saleId = cancelSaleButton.dataset.id;
    const formData = new FormData();
    formData.set("id", saleId || "");

    try {
      const { data, error } = await actions.sales.cancel(formData);

      if (error) {
        throw new Error(error.message);
      }

      alert(data?.message || "Venta cancelada exitosamente");
      // Refresh the page to reflect the changes
      window.location.href = "/products";

    } catch (error) {
      console.error(error);
      alert("Ocurrió un error al cancelar la venta");
    }
  });
</script>
