---
import DashLayout from "../layouts/DashLayout.astro";
import { turso } from "../turso";
import formatCurrency from "../utils";

const { rows } = await turso.execute("SELECT * FROM products");
console.log(rows);
---

<DashLayout>
  <h2 class="my-2">Productos</h2>

  <a href="/products/new" class="btn">Nuevo producto</a>

  {
    rows.length === 0 ? (
      <p>No hay productos registrados.</p>
    ) : (      
      <div class="flex items-center gap-2 my-5">
        <input type="checkbox" id="show-delete" autocomplete="off" class="w-auto"/>
        <label for="show-delete">
         Modo eliminar
        </label>
      </div>

      <div class="overflow-x-auto pb-3 md:pb-0">
        <table>
          <thead>
            <tr>
              <th>Nombre</th>
              <th>Marca</th>
              <th>IMEI</th>
              <th>Precio (COP)</th>
              <th>Precio (USD)</th>
              <th>Stock</th>
              <th>Color</th>
              <th>Almacenamiento</th>
              <th>Estado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td>{row.name}</td>
                <td>{row.brand}</td>
                <td>{row.imei}</td>
                <td>{formatCurrency(Number(row.price))}</td>
                <td>{formatCurrency(Number(row.price_usd), "USD")}</td>
                <td>{row.stock}</td>
                <td>{row.color}</td>
                <td>{row.storage}</td>
                <td>{row.status}</td>

                <td class="flex flex-col gap-1 border-none" id="table-actions">
                  <a href={`/products/${row.id}/edit`} class="btn">
                    Editar
                  </a>
                  <a href="#" class="btn">
                    Vender
                  </a>
                  <button class="hidden btn delete-btn">Eliminar</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</DashLayout>


<script>
  const showDeleteCheckbox = document.getElementById(
    "show-delete"
  ) as HTMLInputElement;
  const deleteButtons = document.querySelectorAll(
    "#table-actions .delete-btn"
  ) as NodeListOf<HTMLButtonElement>;

  if (showDeleteCheckbox || deleteButtons) {
    showDeleteCheckbox.addEventListener("change", () => {
      const isChecked = showDeleteCheckbox.checked;
      deleteButtons.forEach((btn) => {
        btn.style.display = isChecked ? "block" : "none";
      });
    });
  }
</script>
