---
import DashLayout from "../layouts/DashLayout.astro";
import { turso } from "../turso";
import formatCurrency from "../utils";

const PAGE_SIZE = 5;
const { searchParams } = Astro.url;
const page = Math.max(1, parseInt(searchParams.get("page") ?? "1") || 1);
const offset = (page - 1) * PAGE_SIZE;

const [
  {
    rows: [{ count }],
  },
  { rows },
] = await turso.batch([
  { sql: "SELECT COUNT(*) AS count FROM products", args: [] },
  {
    sql: "SELECT id, name, imei, dollar_cop, price_usd, status FROM products ORDER BY created_at DESC LIMIT ? OFFSET ?",
    args: [PAGE_SIZE, offset]
  }
]);
const totalPages = Math.max(1, Math.ceil(Number(count) / PAGE_SIZE));
---

<DashLayout>
  <a href="/products/new" class="btn my-5">Nuevo producto</a>
  
  {
    rows.length > 0 && (
      <div class="flex items-center gap-2 mb-2">
        <input
          type="checkbox"
          id="show-delete"
          autocomplete="off"
          class="w-auto"
        />
        <label for="show-delete">Modo eliminar</label>
      </div>
    )
  }

  {
    rows.length === 0 ? (
      <p class="mt-1">No hay productos registrados.</p>
    ) : (
      <div class="overflow-x-auto pb-3 md:pb-0">
        <table class="mb-10">
          <thead>
            <tr>
              <th>Nombre</th>
              <th>IMEI</th>
              <th>Precio dolar (COP)</th>
              <th>Precio producto (USD)</th>
              <th>Estado</th>
              <th>Valor total</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr>
                <td>{row.name}</td>
                <td>
                  {row.imei
                    ? String(row.imei)
                        .slice(-4)
                        .padStart(String(row.imei).length, "*")
                    : "--"}
                </td>
                <td>{formatCurrency(Number(row.dollar_cop))}</td>
                <td>{formatCurrency(Number(row.price_usd), "USD")}</td>
                <td>{row.status}</td>
                <td>
                  {row.status === "nuevo"
                    ? formatCurrency(
                        Number(row.dollar_cop) * Number(row.price_usd) + 100000
                      )
                    : formatCurrency(
                        Number(row.dollar_cop) * Number(row.price_usd) + 80000
                      )}
                </td>

                <td class="flex flex-col gap-1 border-none" id="table-actions">
                  <a href={`/products/${row.id}/details`} class="btn">
                    Detalles
                  </a>
                  <a href={`/products/${row.id}/edit`} class="btn">
                    Editar
                  </a>
                  
                  <button
                    class="hidden btn delete-btn bg-red-400"
                    data-id={String(row.id)}
                  >
                    Eliminar
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="flex justify-center gap-2">
        {page > 1 && (
          <a href={`/products?page=${page - 1}`} class="btn">
            Anterior
          </a>
        )}
        {page < totalPages && (
          <a href={`/products?page=${page + 1}`} class="btn">
            Siguiente
          </a>
        )}
      </div>
    )
  }
</DashLayout>

<script>
  import { actions, isActionError } from "astro:actions";

  // Show delete buttons when checkbox is checked
  const showDeleteCheckbox = document.getElementById(
    "show-delete"
  ) as HTMLInputElement;
  const deleteButtons = document.querySelectorAll(
    "#table-actions .delete-btn"
  ) as NodeListOf<HTMLButtonElement>;

  if (showDeleteCheckbox || deleteButtons) {
    showDeleteCheckbox.addEventListener("change", () => {
      const isChecked = showDeleteCheckbox.checked;
      deleteButtons.forEach((btn) => {
        btn.style.display = isChecked ? "block" : "none";
      });
    });

    deleteButtons.forEach((btn) => {
      btn.addEventListener("click", async () => {
        const id = btn.dataset.id;
        if (!id) return;

        if (!confirm("¿Estás seguro de eliminar este producto?")) return;

        const formData = new FormData();
        formData.set("id", id);

        const { data, error } = await actions.products.delete(formData);

        if (error && isActionError(error)) {
          alert(error.message);
          return;
        }

        alert(data?.message);
        window.location.reload();
      });
    });
  }

  
</script>
