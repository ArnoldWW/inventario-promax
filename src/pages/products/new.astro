---
import CurrencyInput from "../../components/CurrencyInput.astro";
import DashLayout from "../../layouts/DashLayout.astro";
---

<DashLayout>
  <h2 class="my-2">Nuevo producto</h2>

  <form action="post" id="new-p-form" class="flex flex-col gap-2 my-2 max-w-96">
    <label for="name">Nombre</label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="Nombre del producto"
    />

    <label for="brand">Marca</label>
    <select name="brand" id="brand">
      <option value="apple">Apple</option>
      <option value="samsung">Samsung</option>
      <option value="otro">Otro</option>
    </select>

    <label for="imei">IMEI</label>
    <input
      type="text"
      inputmode="numeric"
      id="imei"
      name="imei"
      pattern="[0-9]*"
      maxlength="15"
      placeholder="IMEI del producto"
    />

    <CurrencyInput
      label="Precio dolar (COP)"
      id="dollar-cop-input"
      name="dollar_cop"
      currency="COP"
      placeholder="$3.500"
    />

    <CurrencyInput
      label="Precio producto (USD)"
      id="price-input-usd"
      name="price_usd"
      currency="USD"
      placeholder="$1,000"
    />

    <label for="color">Color</label>
    <input
      type="text"
      id="color"
      name="color"
      placeholder="Color del producto"
    />

    <label for="storage">Almacenamiento</label>
    <select name="storage" id="storage">
      <option value="64">64 GB</option>
      <option value="128">128 GB</option>
      <option value="256">256 GB</option>
      <option value="512">512 GB</option>
      <option value="1000">1 TB</option>
    </select>

    <label for="status">Estado</label>
    <select name="status" id="status">
      <option value="nuevo">Nuevo</option>
      <option value="usado">Usado</option>
    </select>

    <button type="submit" class="btn my-2">Crear producto</button>
  </form>
</DashLayout>

<script>
  import { actions, isInputError, isActionError } from "astro:actions";

  const form = document.querySelector("#new-p-form") as HTMLFormElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    const dollar_cop = formData.get("dollar_cop") as string;

    const price_usd = formData.get("price_usd") as string;

    if (dollar_cop.trim() && typeof dollar_cop === "string") {
      formData.set("dollar_cop", dollar_cop.replace(/\D/g, ""));
    }

    if (price_usd.trim() && typeof price_usd === "string") {
      formData.set("price_usd", price_usd.replace(/\D/g, ""));
    }

    const { data, error } = await actions.products.create(formData);

    if (error && isInputError(error)) {
      const plainArray = Object.entries(error.fields).map(
        ([field, message]) => {
          return `${field}: ${message}`;
        }
      );

      alert("Campos con error:\n" + plainArray.join("\n"));

      return;
    }

    if (error && isActionError(error)) {
      alert(error.message);
      return;
    }

    alert(data?.message);
    window.location.href = "/products";
  });
</script>
