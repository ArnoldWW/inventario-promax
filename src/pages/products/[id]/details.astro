---
import DashLayout from "@/layouts/DashLayout.astro";
import { turso } from "@/turso";
import { productSchema } from "@/types";
import { formatCurrency } from "@/utils";
import SalesForm from "@/components/SalesForm.astro";

const params = Astro.params;

if (!params.id) {
  return Astro.redirect("/products");
}

const { rows } = await turso.execute("SELECT * FROM products WHERE id = ?", [
  params.id
]);
const raw = rows[0];
const product = raw ? productSchema.parse(raw) : undefined;

if (!product) {
  return Astro.redirect("/products");
}

// Query products table and sale table to get the sale of the product
const { rows: salesRows } = await turso.execute(
  "SELECT customer_name FROM sales WHERE product_id = ? LIMIT 1",
  [product.id]
);
const sale = salesRows[0];
const isSold = Boolean(sale);

const localDate = new Date(String(product.created_at)).toLocaleString("es-CO", {
  timeZone: "America/Bogota",
  dateStyle: "short",
  timeStyle: "short"
});
---

<DashLayout>
  <a href="/products" class="btn my-5 w-auto">&larr;</a>
  <div class="flex flex-col gap-5 max-w-96 pb-5">
    {isSold && (
      <p class="text-green-500 uppercase font-bold bg-green-100 p-2 text-center">
        PRODUCTO VENDIDO A {sale.customer_name}
      </p>
    )}

    <div>
      <h2>Detalles del producto</h2>

      <div class="flex flex-col gap-2 my-2">
        <p>
          <strong>Nombre: </strong>
          {product.name} - (
          {product.origin.toUpperCase()})
        </p>
        <p>
          <strong>Marca: </strong>
          {product.brand}
        </p>
        <p>
          <strong>IMEI: </strong>
          {product.imei}
        </p>

        <p>
          <strong>Color: </strong>
          {product.color}
        </p>
        <p>
          <strong>Almacenamiento: </strong>
          {product.storage} GB
        </p>

        <p>
          <strong>Proveedor: </strong>
          {product.provider}
        </p>
        <p>
          <strong>Batería: </strong>
          {product.battery}%
        </p>

        <p>
          <strong>Estado: </strong>
          {product.status}
        </p>

        {
          product.origin === "importado" && (
            <>
              <p>
                <strong>Precio producto (USD):</strong>{" "}
                {formatCurrency(product.price_usd, "USD")}
              </p>
              <p>
                <strong>Precio dolar (COP):</strong>{" "}
                {formatCurrency(product.dollar_cop)}
              </p>
            </>
          )
        }

        {
          product.origin === "local" && (
            <p>
              <strong>Precio producto (COP):</strong>{" "}
              {formatCurrency(product.price_cop)}
            </p>
          )
        }

        <p>
          <strong>Creado:</strong>
          {localDate}
        </p>

        <a href={`/products/${product.id}/edit`} class="btn">
          Editar producto
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-2 my-2">
      {!isSold ?
        <h2>
          Vender - <span class="text-blue-500"> {product.name}</span>
        </h2>
        <SalesForm productId={product.id} />
      : null}
    </div>
  </div>
</DashLayout>
