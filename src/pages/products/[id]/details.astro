---
import DashLayout from "@/layouts/DashLayout.astro";
import { turso } from "@/turso";
import { productSchema } from "@/types";
import { formatCurrency } from "@/utils";

const params = Astro.params;

if (!params.id) {
  return Astro.redirect("/products");
}

const { rows } = await turso.execute("SELECT * FROM products WHERE id = ?", [
  params.id
]);

const raw = rows[0];

const product = raw ? productSchema.parse(raw) : undefined;

if (!product) {
  return Astro.redirect("/products");
}

const localDate = new Date(String(product.created_at)).toLocaleString("es-CO", {
  timeZone: "America/Bogota",
  dateStyle: "short",
  timeStyle: "short"
});
---

<DashLayout>
  <a href="/products" class="btn my-5">&larr;</a>

  <h2 class="my-2">Detalles del producto</h2>

  {
    !product ? (
      <p>No se encontró el producto con ID {params.id}</p>
    ) : (
      <div class="flex flex-col gap-2 my-2 max-w-96">
        <p>
          <strong>Nombre:</strong> {product.name} - (
          {product.origin.toUpperCase()})
        </p>
        <p>
          <strong>Marca:</strong> {product.brand}
        </p>
        <p>
          <strong>IMEI:</strong> {product.imei}
        </p>

        <p>
          <strong>Color:</strong> {product.color}
        </p>
        <p>
          <strong>Almacenamiento:</strong> {product.storage} GB
        </p>

        <p>
          <strong>Proveedor:</strong> {product.provider}
        </p>
        <p>
          <strong>Batería:</strong> {product.battery}%
        </p>

        <p>
          <strong>Estado:</strong> {product.status}
        </p>

        {product.origin === "importado" && (
          <>
            <p>
              <strong>Precio producto (USD):</strong>{" "}
              {formatCurrency(product.price_usd, "USD")}
            </p>
            <p>
              <strong>Precio dolar (COP):</strong>{" "}
              {formatCurrency(product.dollar_cop)}
            </p>
          </>
        )}

        {product.origin === "local" && (
          <p>
            <strong>Precio producto (COP):</strong> {product.price_cop}
          </p>
        )}

        <p>
          <strong>Creado:</strong> {localDate}
        </p>

        <a href={`/products/${product.id}/edit`} class="btn">
          Editar producto
        </a>
      </div>
    )
  }
</DashLayout>
